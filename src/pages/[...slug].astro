---
import { render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import Page from '../layouts/Page.astro';
import { docMeta, getPages } from '../lib/docs';
export async function getStaticPaths() {
  // Sponsors has a bespoke page in src/pages/sponsors.astro.
  const pages = (await getPages()).filter(doc => !/(^|\/)sponsors$/.test(doc.id));
  return pages.map(entry => ({ params: { slug: entry.id.replace(/\/index$/, '') }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, lang, source, anchor, path } = docMeta(entry);
const Layout = entry.data.layout === 'page' ? Page : Docs;
---
<Layout description={description} title={title} lang={lang} path={path} source={source} anchor={anchor} headings={headings}>
  <Content />
</Layout>
