---
import { parse } from 'yaml';
import english from '../../docs/index.md?raw';
import chinese from '../../docs/zh-Hans/index.md?raw';
import Base from '../layouts/Base.astro';
import Sidebar from './Sidebar.astro';
import Icon from './Icon.astro';
import { href, type Language } from '../lib/navigation';
const { lang='en' }=Astro.props as {lang:Language}; const zh=lang==='zh';
const { hero, features }=parse((zh?chinese:english).replace(/\r\n/g,'\n').match(/^---\n([\s\S]*?)\n---/)![1]) as {hero:{name:string;text:string;tagline:string;actions:{theme:string;text:string;link:string}[]};features:{title:string;details:string;link?:string}[]};
const target=(link:string)=>link.startsWith('http')?link.replace('github.com/BakaSU/','github.com/Baka-SU/'):href(link.replace(/^\.\//,'/').replace(/\.md$/,''),lang);
const icons=['android','device','bolt','settings','shield','telegram'];
const colors=['bg-sky-50 text-sky-600 dark:bg-sky-950/50 dark:text-sky-400','bg-green-50 text-green-600 dark:bg-green-950/50 dark:text-green-400','bg-yellow-50 text-yellow-600 dark:bg-yellow-950/50 dark:text-yellow-400','bg-pink-50 text-pink-600 dark:bg-pink-950/50 dark:text-pink-400','bg-sky-50 text-sky-600 dark:bg-sky-950/50 dark:text-sky-400','bg-green-50 text-green-600 dark:bg-green-950/50 dark:text-green-400'];
const paths=[
  {path:'/guide/install',icon:'download',label:zh?'安装指南':'Installation guide',description:zh?'在你的设备上开始使用 BakaSU':'Set up BakaSU on your device'},
  {path:'/guide/build',icon:'terminal',label:zh?'构建内核':'Build your kernel',description:zh?'编译内核并集成 BakaSU':'Compile and integrate BakaSU'},
  {path:'/guide/unofficial-devices',icon:'device',label:zh?'支持设备':'Find your device',description:zh?'浏览社区支持的内核项目':'Browse community-supported kernels'},
];
---
<Base title="BakaSU" description={hero.tagline} lang={lang}>
  <div class="min-[801px]:hidden"><Sidebar lang={lang} path="/" /></div>
  <main id="main-content" data-pagefind-body class="mx-auto max-w-[1200px] px-6 sm:px-10">
    <section class="grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:gap-16 lg:py-24">
      <div><p class="mb-5 flex items-center gap-2 text-sm font-medium text-sky-600 dark:text-sky-400"><span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>{hero.name}</p><h1 class="max-w-2xl text-[42px] leading-[1.12] font-mono font-[450] tracking-[-0.035em] sm:text-[56px] lg:text-[64px]" data-pagefind-meta="title">{hero.text}</h1><p class="mt-6 max-w-xl text-base leading-7 text-zinc-500 sm:text-lg sm:leading-8 dark:text-zinc-400">{hero.tagline}</p><div class="mt-8 flex flex-wrap items-center gap-3">{hero.actions.map((action,index)=><a class:list={['inline-flex h-11 items-center gap-2 rounded-lg px-5 text-sm font-medium transition-colors',index===0?'bg-sky-600 text-white hover:bg-sky-700 dark:bg-sky-600 dark:text-white dark:hover:bg-sky-500':'border border-zinc-200 bg-white hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:hover:bg-zinc-900']} href={target(action.link)} {...(action.link.startsWith('https:')?{target:'_blank',rel:'noopener noreferrer'}:{})}>{index===1&&<Icon name="github" size={17}/>}{action.text}{index===0&&<Icon name="right" size={16}/>}</a>)}</div></div>
      <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-900/30">
        <div class="relative flex h-52 items-center justify-center px-6 sm:h-60">
          <div class="absolute h-36 w-36 rounded-full bg-sky-100/70 blur-3xl dark:bg-sky-900/30"></div>
          <div class="absolute right-8 top-8 h-16 w-16 rounded-full bg-yellow-100/60 blur-2xl dark:bg-yellow-900/30"></div>
          <div class="absolute bottom-6 left-8 h-20 w-20 rounded-full bg-green-100/60 blur-2xl dark:bg-green-900/30"></div>
          <img src="/brand-mark.svg" alt="BakaSU Logo" width="304" height="204" fetchpriority="high" class="relative w-60 sm:w-72"/>
        </div>
        <nav aria-labelledby="home-documentation" class="border-t border-zinc-200 bg-white p-4 sm:p-5 dark:border-zinc-800 dark:bg-zinc-950/70">
          <h2 id="home-documentation" class="mb-3 flex items-center gap-2 px-3 font-mono text-xs font-medium tracking-wide text-zinc-500 dark:text-zinc-400"><Icon name="book" size={15}/>{zh?'文档导航':'Documentation'}</h2>
          <ul class="space-y-1">{paths.map(item=><li><a class="group flex min-h-18 items-center gap-3 rounded-xl px-3 py-3 transition-colors hover:bg-sky-50 focus-visible:bg-sky-50 dark:hover:bg-sky-950/40 dark:focus-visible:bg-sky-950/40" href={href(item.path,lang)}>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-50 text-zinc-600 transition-colors group-hover:border-sky-200 group-hover:bg-white group-hover:text-sky-600 group-focus-visible:text-sky-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:group-hover:border-sky-900 dark:group-hover:bg-sky-950 dark:group-hover:text-sky-400 dark:group-focus-visible:text-sky-400"><Icon name={item.icon} size={19}/></span>
            <span class="min-w-0"><span class="block text-sm font-medium text-zinc-900 dark:text-zinc-100">{item.label}</span><span class="mt-1 block text-xs leading-5 text-zinc-500 dark:text-zinc-400">{item.description}</span></span>
            <span class="ml-auto shrink-0 text-zinc-400 transition-colors group-hover:text-sky-600 group-focus-visible:text-sky-600 dark:group-hover:text-sky-400 dark:group-focus-visible:text-sky-400"><Icon name="right" size={16}/></span>
          </a></li>)}</ul>
        </nav>
      </div>
    </section>
    <section class="mb-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-zinc-800 dark:bg-zinc-800" aria-label={zh?'项目特性':'Project features'}>{features.map((feature,index)=><article class="bg-white p-7 sm:p-8 dark:bg-zinc-950"><span class:list={['mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg',colors[index]]}><Icon name={icons[index]} size={21}/></span><h2 class="text-base font-semibold tracking-tight">{feature.title}</h2><p class="mt-3 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{feature.details}</p>{feature.link&&<a class="mt-5 inline-flex items-center gap-1.5 text-xs font-medium hover:text-sky-600 dark:hover:text-sky-400" href={target(feature.link)} {...(feature.link.startsWith('https:')?{target:'_blank',rel:'noopener noreferrer'}:{})}>{feature.title}<Icon name="arrow" size={13}/></a>}</article>)}</section>
    <section class="mb-14 flex flex-col items-start justify-between gap-5 rounded-xl border border-zinc-200 bg-zinc-50 px-7 py-6 sm:flex-row sm:items-center dark:border-zinc-800 dark:bg-zinc-900/30"><div><h2 class="text-base font-medium">{zh?'寻找答案':'Find your answer'}</h2><p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400">{zh?'搜索指南、设备与内核集成。':'Search guides, devices, and kernel integration.'}</p></div><button class="inline-flex h-10 items-center gap-3 rounded-lg border border-zinc-200 bg-white px-4 text-sm transition-colors hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-950 dark:hover:border-zinc-500" data-search-open><Icon name="search" size={16}/>{zh?'搜索文档':'Search docs'}<kbd>⌘ K</kbd></button></section>
  </main>
  <footer class="border-t border-zinc-200 dark:border-zinc-800"><div class="mx-auto flex max-w-[1200px] flex-col justify-between gap-5 px-6 py-8 text-xs leading-6 text-zinc-400 sm:flex-row sm:px-10"><div><p>Documented with ❤️ by BakaSU Development</p><p>Copyright © 2025–2026 BakaSU, under MIT License</p></div><div class="flex items-center gap-5"><a href="/llms.txt" class="hover:text-zinc-950 dark:hover:text-white">AI docs</a><a href="https://github.com/Baka-SU" aria-label="GitHub"><Icon name="github" size={18}/></a><a href="https://t.me/BAKASU_grp" aria-label="Telegram"><Icon name="telegram" size={18}/></a></div></div></footer>
</Base>
