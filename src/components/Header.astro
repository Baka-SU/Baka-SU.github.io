---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { copy, href, topNavigation, type Language } from '../lib/navigation';
const { lang, path, docs = false } = Astro.props as { lang: Language; path: string; docs?: boolean };
const t = copy(lang); const index = lang === 'zh' ? 1 : 0;
const otherPath = lang === 'zh' ? path : href(path, 'zh');
const control = 'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white';
---
<header class="sticky top-0 z-40 h-16 border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/95"><div class="mx-auto flex h-full max-w-[1440px] items-center gap-5 px-4 sm:px-6 lg:px-8">
  <Brand lang={lang} />
  <nav class="hidden h-full items-center gap-6 pl-4 text-sm min-[1000px]:flex" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>{topNavigation.map(item => item.path ? <a class:list={['inline-flex h-full items-center transition-colors hover:text-zinc-950 dark:hover:text-white', item.path === '/' ? path === '/' ? 'font-medium text-zinc-950 dark:text-white' : 'text-zinc-500' : item.path === '/guide/install' && docs || path === item.path ? 'font-medium text-zinc-950 dark:text-white' : 'text-zinc-500']} href={href(item.path,lang)}>{item.title[index]}</a> : <details class="group relative"><summary class="flex cursor-pointer list-none items-center gap-1.5 text-zinc-500 [&::-webkit-details-marker]:hidden">{item.title[index]}<Icon name="chevron-down" size={12} /></summary><div class="absolute left-0 top-9 w-56 rounded-xl border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-900">{item.items?.map(link=><a class="flex items-center justify-between rounded-md px-3 py-2.5 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-800" href={link.path} target="_blank" rel="noopener noreferrer">{link.title[index]}<Icon name="arrow" size={14} /></a>)}</div></details>)}</nav>
  <button class="ml-auto flex h-9 w-9 items-center justify-center gap-3 rounded-lg border border-transparent text-zinc-500 transition-colors hover:bg-zinc-100 sm:w-56 sm:justify-start sm:border-zinc-200 sm:bg-zinc-50 sm:px-3 lg:w-64 dark:hover:bg-zinc-900 dark:sm:border-zinc-800 dark:sm:bg-zinc-900/50" data-search-open aria-label={t.search}><Icon name="search" size={16} /><span class="hidden text-xs sm:block">{t.search}</span><kbd class="ml-auto hidden sm:block">⌘ K</kbd></button>
  <div class="flex items-center gap-0.5 sm:gap-1"><a class={control} href={otherPath} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={lang === 'zh' ? 'Switch to English' : '切换到简体中文'}><Icon name="globe" size={18} /></a><button class={control} data-theme-toggle aria-label={lang === 'zh' ? '切换主题' : 'Toggle color theme'}><Icon name="sun" class="theme-sun" size={18} /><Icon name="moon" class="theme-moon" size={18} /></button><a class:list={[control,'max-sm:hidden']} href="https://github.com/Baka-SU" target="_blank" rel="noopener noreferrer" aria-label="BakaSU on GitHub"><Icon name="github" size={19} /></a><a class:list={[control,'max-[1100px]:hidden']} href="https://t.me/BAKASU_grp" target="_blank" rel="noopener noreferrer" aria-label="BakaSU on Telegram"><Icon name="telegram" size={19} /></a><button class:list={[control,'min-[801px]:hidden']} data-menu-toggle aria-label={t.menu} aria-expanded="false" aria-controls="docs-sidebar"><Icon name="menu" size={20} /></button></div>
</div></header>
