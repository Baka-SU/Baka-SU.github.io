{
  "name": "bakasu-docs",
  "version": "2.0.0",
  "private": true,
  "description": "BakaSU documentation — a static Astro site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm:build": "node tools/gki-lkm-patcher/build.mjs",
    "dev": "bun run docs:dev",
    "docs:dev": "bun run wasm:build && bun run docs:prepare && astro dev",
    "build": "bun run docs:build",
    "docs:build": "bun run wasm:build && bun run docs:prepare && astro build && pagefind --site dist && node scripts/postbuild.mjs",
    "generate": "bun run docs:build",
    "preview": "bun run docs:preview",
    "docs:preview": "astro preview",
    "check": "bun run docs:prepare && astro check",
    "postinstall": "cargo install wasm-pack --version 0.15.0 --locked",
    "docs:prepare": "node scripts/prepare-docs.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vue": "7.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify-json/tabler": "1.2.42",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "pagefind": "1.5.2",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
